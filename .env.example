# 复制为 .env 后按需修改；不提交到版本库
# 后端端口
PORT=3001

# 监听网卡。默认不设置 = 双栈监听（IPv4 + IPv6），localhost 与局域网 IP 都能访问。
# 只在需要限制网卡时才显式指定，例如只想监听 IPv4：HOST=0.0.0.0
# HOST=0.0.0.0

# JWT 签名密钥。留空时会自动生成 data/.auth-secret（仅适合本地演示）
# AUTH_SECRET=change-me-to-a-random-32-byte-string

# 额外允许的跨域来源，逗号分隔；localhost 与局域网 IP 默认放行
# CORS_ORIGINS=https://your-domain.com

# 接入真实大模型（OpenAI 兼容协议）
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-xxxx
# AI_MODEL=gpt-4o-mini

# 调试：打印每条请求
# LOG_REQ=1
